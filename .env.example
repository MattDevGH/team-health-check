# Team Health Check — Environment Variables
# Copy this file to .env and fill in your values.
#
# None of these are required for running tests: unit and route tests use
# in-memory fakes, and the integration tests create their own temporary files.
# They ARE required for running the app with real Slack and email delivery.
#
# Full reference, including which are secret and what happens when one is wrong:
#   docs/deployment.md

# WHICH FILE SHOULD THIS GO IN?
#
#   .env.local   your machine’s development secrets. Next.js prefers it over
#                .env, and skips it entirely when NODE_ENV=test, so a test run
#                uses the same defaults for everyone rather than yours.
#
#   .env.turso   production database credentials, and nothing else. Next.js
#                loads only .env, .env.local, .env.<NODE_ENV> and
#                .env.<NODE_ENV>.local — so it never sees this one, and
#                production credentials cannot repoint the dev server as a
#                side effect. Read by scripts/migrate-production.ts alone.
#
#   Vercel       everything production actually runs on. Never a file.

# ─── App ───────────────────────────────────────────────────────────────────────
# Public URL of the deployed app. Embedded in magic link emails and Slack
# messages, so a stale value sends real people to localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database ──────────────────────────────────────────────────────────────────
# Local development needs none of this: the app opens prisma/dev.db by default.
#
# DATABASE_URL names which local SQLite file to open. The E2E suite sets it to a
# disposable database; leave it unset for ordinary development.
DATABASE_URL=""

# Production only. The *presence* of TURSO_DATABASE_URL is what selects the
# libSQL adapter over local SQLite, so setting it locally switches the app to
# Turso too. A production process refuses to start without it, because the local
# fallback is a file a serverless deployment cannot persist.
#
# Setting this also makes the Prisma CLI refuse to run — it cannot reach Turso,
# and left to resolve it would migrate a local file and report success. Use
# `npx tsx scripts/migrate-production.ts` instead.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ─── Slack ─────────────────────────────────────────────────────────────────────
# Optional. Left empty, Slack delivery is skipped and the web interface works
# normally.
#
# From: api.slack.com/apps → Your App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=""

# From: api.slack.com/apps → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# From: resend.com/api-keys
RESEND_API_KEY=""

# Sender address. onboarding@resend.dev delivers ONLY to the Resend account
# owner and drops everyone else silently — which for a magic link is
# indistinguishable from the link never being requested. Verify a domain before
# giving this to a team.
EMAIL_SENDER="Team Health Check <noreply@yourdomain.com>"

# ─── Scheduler ─────────────────────────────────────────────────────────────────
# Shared secret for authenticating cron requests to POST /api/scheduler/tick.
# Generate a fresh one for production; do not reuse this value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Hours before a session closes to send closing reminders (Requirement 13.2).
# Optional — defaults to 24 when unset, empty, or not a positive number.
CLOSING_REMINDER_LEAD_HOURS=""

# ─── Never set these in a deployed environment ────────────────────────────────
# Listed so they are recognisable, not so they are used.
#
# TEST_MODE makes /api/test/magic-link return live sign-in tokens — a complete
# authentication bypass for anyone who can reach the URL. The application
# refuses to run if it is set in production.
#
# E2E_LOCAL_RUN marks a process as a local end-to-end run and disables the
# production startup checks. It is set in playwright.config.ts and nowhere else.
